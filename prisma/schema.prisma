// Kusi Safaris Rates & Quotes — database schema
//
// Money handling: every monetary amount is stored as an integer number of
// "cents" (smallest currency unit) to avoid floating point rounding errors.
// Business logic converts to/from Decimal (decimal.js) only for arithmetic.
//
// Currency conversion: the exchange rate is stored as an integer
// "rateMicros" = (KES per 1 USD) * 1,000,000, giving 6 decimal places of
// precision without floating point.
//
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Settings (singleton)
// ---------------------------------------------------------------------------

model Settings {
  id         String   @id @default("singleton")
  // KES per 1 USD, scaled by 1,000,000
  rateMicros Int
  updatedAt  DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Shared enums
// ---------------------------------------------------------------------------

enum Currency {
  USD
  KES
}

enum Season {
  LOW
  SHOULDER
  HIGH
}

enum MealPlan {
  NO_MEALS // No Meals
  BB // Bed & Breakfast
  HB // Half Board
  FB // Full Board
  FI // Fully Inclusive
}

enum PricingBasis {
  PER_PERSON
  PER_ROOM
}

enum VehicleType {
  VAN
  JEEP_5PAX
  JEEP_8PAX
}

enum QuoteStatus {
  DRAFT
  FINAL
  ARCHIVED
}

// A rate-library category, used on QuoteLineItem to tag which kind of item
// it represents (library-backed or manual).
enum LineItemCategory {
  ACCOMMODATION
  PRIVATE_TRANSPORT
  TRAIN
  TAXI_TRANSFER
  ACTIVITY
  PARK_ENTRANCE_FEE
  DOMESTIC_FLIGHT
  VILLA
  MISC
  LODGE_ACTIVITY
}

// How a Lodge Activity's price is applied. Kept as its own enum (rather than
// reusing PricingBasis) since a lodge activity supports a third mode
// (FIXED_PRICE) that accommodation rates don't have — extensible if more
// bases are needed later without touching accommodation pricing.
enum LodgeActivityPricingBasis {
  PER_PERSON
  PER_GROUP
  FIXED_PRICE
}

// ---------------------------------------------------------------------------
// Rate Library: Accommodation
// ---------------------------------------------------------------------------

model Accommodation {
  id           String       @id @default(cuid())
  name         String
  location     String
  notes        String?
  currency     Currency
  pricingBasis PricingBasis
  archived     Boolean      @default(false)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  roomTypes        AccommodationRoomType[]
  rates            AccommodationRate[]
  childAgeBrackets AccommodationChildAgeBracket[]
  activities       AccommodationActivity[]

  @@index([name])
  @@index([archived])
}

// A "Lodge Activity": an activity specific to one accommodation (e.g. a
// guided bush walk only available to guests staying there), kept separate
// from the general Activities Rate Library on purpose — it belongs to the
// accommodation, not the other way around, and never appears as a
// standalone general Activity. Version 1 prices it as a single flat
// amount (no per-rate/season/child-bracket matrix like accommodation room
// rates); `amountCents` + `pricingBasis` is deliberately its own small
// shape so child-specific pricing could be layered on later without a
// rebuild, the same way Accommodation/Park child brackets were added on
// top of an existing flat-rate shape.
model AccommodationActivity {
  id              String                     @id @default(cuid())
  accommodationId String
  name            String
  pricingBasis    LodgeActivityPricingBasis
  amountCents     Int
  currency        Currency
  notes           String?
  archived        Boolean                    @default(false)
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt

  accommodation Accommodation @relation(fields: [accommodationId], references: [id], onDelete: Cascade)

  @@index([accommodationId])
  @@index([archived])
}

// Every accommodation defines its own child age brackets (spec: "the whole
// purpose of this change is that each supplier/entity may define them
// differently" — brackets are never shared globally or across suppliers).
model AccommodationChildAgeBracket {
  id              String  @id @default(cuid())
  accommodationId String
  minAge          Int
  maxAge          Int
  label           String?
  sortOrder       Int     @default(0)

  accommodation Accommodation            @relation(fields: [accommodationId], references: [id], onDelete: Cascade)
  childRates    AccommodationChildRate[]

  @@index([accommodationId])
}

model AccommodationRoomType {
  id              String @id @default(cuid())
  accommodationId String
  name            String
  sortOrder       Int    @default(0)

  accommodation Accommodation       @relation(fields: [accommodationId], references: [id], onDelete: Cascade)
  rates         AccommodationRate[]

  @@index([accommodationId])
}

// One row per (room type, season, meal plan) combination. Only the fields
// relevant to the accommodation's pricingBasis are populated; the others
// stay null. This mirrors the rate-entry grid in the UI directly.
model AccommodationRate {
  id              String   @id @default(cuid())
  accommodationId String
  roomTypeId      String
  season          Season
  mealPlan        MealPlan

  // PER_PERSON fields (cents)
  adultSharingCents Int?
  singleCents       Int?

  // PER_ROOM fields (cents)
  standardRoomCents Int?
  singleRoomCents   Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accommodation Accommodation            @relation(fields: [accommodationId], references: [id], onDelete: Cascade)
  roomType      AccommodationRoomType    @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  childRates    AccommodationChildRate[]

  @@unique([roomTypeId, season, mealPlan])
  @@index([accommodationId])
}

// One price per (rate row, accommodation-specific child age bracket).
// Replaces the old fixed child5to12Cents/childUnder5Cents columns so the
// number and definition of child brackets can vary freely per accommodation.
model AccommodationChildRate {
  id                  String @id @default(cuid())
  accommodationRateId String
  bracketId           String
  priceCents          Int

  accommodationRate AccommodationRate            @relation(fields: [accommodationRateId], references: [id], onDelete: Cascade)
  bracket           AccommodationChildAgeBracket @relation(fields: [bracketId], references: [id], onDelete: Cascade)

  @@unique([accommodationRateId, bracketId])
  @@index([accommodationRateId])
  @@index([bracketId])
}

// ---------------------------------------------------------------------------
// Rate Library: Private Transport & Guide
// ---------------------------------------------------------------------------

model TransportRate {
  id          String      @id @default(cuid())
  vehicleType VehicleType
  priceCents  Int
  currency    Currency
  notes       String?
  archived    Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([vehicleType])
  @@index([archived])
}

// ---------------------------------------------------------------------------
// Rate Library: Train
// ---------------------------------------------------------------------------

model TrainJourney {
  id               String   @id @default(cuid())
  route            String
  firstClassCents  Int
  secondClassCents Int
  currency         Currency
  notes            String?
  archived         Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([route])
  @@index([archived])
}

// ---------------------------------------------------------------------------
// Rate Library: Taxi Transfer
// ---------------------------------------------------------------------------

model TransferRate {
  id         String   @id @default(cuid())
  route      String
  priceCents Int
  currency   Currency
  notes      String?
  archived   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([route])
  @@index([archived])
}

// ---------------------------------------------------------------------------
// Rate Library: Activities
// ---------------------------------------------------------------------------

model ActivityRate {
  id         String   @id @default(cuid())
  name       String
  location   String
  priceCents Int
  currency   Currency
  notes      String?
  archived   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([name])
  @@index([archived])
}

// ---------------------------------------------------------------------------
// Rate Library: Park Entrance Fees
// ---------------------------------------------------------------------------

model Park {
  id            String   @id @default(cuid())
  name          String
  currency      Currency
  adultFeeCents Int
  notes         String?
  archived      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  childBrackets ParkChildAgeBracket[]

  @@index([name])
  @@index([archived])
}

// Unlike accommodation (where a price varies by room/season/meal plan and so
// is normalized into a separate join row), a park has exactly one rate, so
// the bracket and its price live together on one row.
model ParkChildAgeBracket {
  id         String  @id @default(cuid())
  parkId     String
  minAge     Int
  maxAge     Int
  priceCents Int
  label      String?
  sortOrder  Int     @default(0)

  park Park @relation(fields: [parkId], references: [id], onDelete: Cascade)

  @@index([parkId])
}

// ---------------------------------------------------------------------------
// Rate Library: Domestic Flights
// ---------------------------------------------------------------------------

model FlightRate {
  id         String   @id @default(cuid())
  route      String
  priceCents Int
  currency   Currency
  notes      String?
  archived   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([route])
  @@index([archived])
}

// ---------------------------------------------------------------------------
// Quotes
// ---------------------------------------------------------------------------

model Quote {
  id         String   @id @default(cuid())
  clientName String
  tripTitle  String
  startDate  DateTime
  endDate    DateTime

  adults Int @default(1)

  status QuoteStatus @default(DRAFT)

  // Exchange rate snapshot: KES per 1 USD, scaled by 1,000,000, captured
  // when the quote was created (or last explicitly refreshed).
  rateMicros Int

  // Future selling-price architecture (Version 1 leaves these null and the
  // UI never surfaces them). Kept separate from cost fields on purpose so
  // margin logic can be layered on later without touching the cost engine.
  marginPercent     Int? // basis points (1/100 of a percent), e.g. 1500 = 15.00%
  sellingPriceCents Int?

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  days     QuoteDay[]
  children QuoteChild[]

  @@index([status])
  @@index([clientName])
}

// One row per child travelling on the quote, storing their exact age (never
// only an aggregated bracket) so each supplier/product can match it against
// its own age brackets independently. `age` is null only for a row migrated
// from the old aggregate categories, where the exact age cannot be known;
// `legacyLabel` preserves what that migrated row used to represent (e.g.
// "5-12") so historical quotes stay readable without inventing precision
// that was never captured.
model QuoteChild {
  id          String  @id @default(cuid())
  quoteId     String
  age         Int?
  legacyLabel String?

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId])
}

model QuoteDay {
  id        String   @id @default(cuid())
  quoteId   String
  date      DateTime
  dayNumber Int

  quote     Quote           @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  lineItems QuoteLineItem[]

  @@unique([quoteId, dayNumber])
  @@index([quoteId])
}

// A flexible line item. `data` holds a JSON payload whose shape depends on
// `category` (see src/lib/quote/line-items.ts for the discriminated-union
// types that are parsed out of it). Common cost fields are kept as real
// columns so totals can be computed/queried without parsing JSON.
model QuoteLineItem {
  id        String           @id @default(cuid())
  dayId     String
  category  LineItemCategory
  sortOrder Int              @default(0)

  // If this line item was created from a Rate Library entry, its source id
  // (kept for reference only — never re-read for pricing after creation).
  sourceId String?

  // Human-readable snapshot description shown in the UI/Word doc, frozen at
  // the time the item was added (e.g. "Samburu Intrepids — Deluxe Tent").
  description String

  // Original entered currency/price, preserved for display + snapshot
  // fidelity, independent of the USD figure used for totals.
  originalCurrency  Currency
  // Simple "unit x quantity" categories populate these directly; for
  // Accommodation (a composite of several guest/room rates) they are left
  // null and the full breakdown lives in `data` instead.
  originalUnitCents Int?
  quantity          Int?

  // Total in the original currency (always present — the single source of
  // truth for display), and its USD conversion (always present — the
  // number used for quote totals).
  originalTotalCents Int
  // Exchange rate snapshot used to convert this line to USD (may differ
  // slightly from the quote-level rate only if this item predates a
  // mid-edit refresh; normally equal to the parent Quote.rateMicros).
  rateMicros         Int
  totalUsdCents      Int

  // Manual override support (spec section 38): what the Rate Library would
  // have produced, preserved for reference, vs. originalTotalCents which is
  // the (possibly overridden) figure actually used for this quote.
  manualOverride    Boolean   @default(false)
  libraryTotalCents Int?
  libraryCurrency   Currency?

  notes String?

  // Category-specific structured data (room type, season, meal plan,
  // vehicle type, passenger counts, etc.) — see line-items.ts.
  data String // JSON

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  day QuoteDay @relation(fields: [dayId], references: [id], onDelete: Cascade)

  @@index([dayId])
  @@index([category])
}
