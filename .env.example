# Local dev (Postgres via docker compose)
DATABASE_URL="postgresql://kusi:kusi@127.0.0.1:5432/kusi?schema=public"

# Optional: seed demo data on container start (Docker / Dokploy)
# RUN_SEED=true

# Required in production: signs the login session cookie. Generate with
# `openssl rand -base64 32`. In local dev this falls back to an insecure
# built-in value if unset (sessions just won't survive a server restart).
SESSION_SECRET=
