# Local dev (Postgres via docker compose)
DATABASE_URL="postgresql://kusi:kusi@127.0.0.1:5432/kusi?schema=public"

# Optional: seed demo data on container start (Docker / Dokploy)
# RUN_SEED=true

# Optional: set both to gate the whole app behind a browser username/password
# prompt (HTTP Basic Auth). Leave both unset for no login prompt.
# BASIC_AUTH_USERNAME=
# BASIC_AUTH_PASSWORD=
